{
  "name": "btree-server",
  "private": true,
  "description": "b.tree backend based on Node.js, Fastify, and Kysely",
  "keywords": [],
  "homepage": "https://github.com/HannesOberreiter/btree_server#readme",
  "bugs": {
    "url": "https://github.com/HannesOberreiter/btree_server/issues"
  },
  "license": "AGPL-3.0",
  "author": "Hannes Oberreiter",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HannesOberreiter/btree_server.git"
  },
  "type": "module",
  "main": "./dist/app.bootstrap.js",
  "scripts": {
    "serve": "nodemon",
    "build": "tsc",
    "migrate": "knex migrate:latest",
    "db:types": "node scripts/update-db-types.mjs",
    "dev:init": "ENVIRONMENT=development knex migrate:latest && ENVIRONMENT=development knex seed:run",
    "dev:serve": "ENVIRONMENT=development nodemon --delay 2000ms",
    "dev:serve:us": "ENVIRONMENT=development SERVER=us nodemon --delay 2000ms",
    "dev:build": "tsc --watch",
    "dev:knex": "ENVIRONMENT=development knex",
    "dev:knex:us": "ENVIRONMENT=development SERVER=us knex",
    "test:e2e": "ENVIRONMENT=test vitest run",
    "test:watch": "ENVIRONMENT=test vitest",
    "ci:e2e": "ENVIRONMENT=ci vitest run",
    "lint": "oxlint . && oxfmt --check .",
    "lint:fix": "oxlint . --fix && oxfmt --write ."
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/formbody": "^9.0.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/session": "^11.1.3",
    "@fastify/swagger": "^9.9.0",
    "@mistralai/mistralai": "^2.7.0",
    "@modelcontextprotocol/fastify": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@mollie/api-client": "^4.6.0",
    "ajv-formats": "^3.0.1",
    "archiver": "^8.0.0",
    "close-with-grace": "^2.2.0",
    "connect-redis": "^10.0.0",
    "csv-parse": "^7.0.2",
    "csv-stringify": "^6.8.3",
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.3",
    "dropbox": "^10.47.0",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^6.1.0",
    "google-auth-library": "^11.1.0",
    "http-errors": "^2.0.0",
    "ical-generator": "^11.1.1",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.3.0",
    "kysely": "^0.28.17",
    "lodash-es": "^4.17.21",
    "mysql": "^2.18.1",
    "mysql2": "^3.24.4",
    "node-schedule": "^2.1.0",
    "nodemailer": "^10.0.10",
    "pino": "^10.3.1",
    "pino-abstract-transport": "^3.0.0",
    "proj4": "^2.22.0",
    "query-string": "^9.5.1",
    "redis": "^5.11.0",
    "ua-parser-js": "^2.0.10",
    "yauzl-promise": "^4.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/http-errors": "^2.0.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.25",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.20.4",
    "@types/node-schedule": "^2.1.0",
    "@types/nodemailer": "^8.0.2",
    "kysely-codegen": "^0.20.0",
    "nodemon": "^3.0.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.67.0",
    "oxlint-tsgolint": "^0.23.0",
    "typescript": "^5.0.4",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.4.0"
}
