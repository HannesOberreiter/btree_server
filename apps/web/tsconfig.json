{
  "extends": "@quasar/app-vite/tsconfig-preset",
  "compilerOptions": {
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "strictNullChecks": false,
    "sourceMap": false,
    "inlineSourceMap": false,
    "forceConsistentCasingInFileNames": true,
    "types": ["@quasar/quasar-app-extension-testing-e2e-cypress"],
    "baseUrl": ".",
    "paths": {
      "~/*": ["src/*"]
    }
  }
}
