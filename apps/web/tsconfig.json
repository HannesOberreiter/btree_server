{
  "extends": "@quasar/app-vite/tsconfig-preset",
  "compilerOptions": {
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "strictNullChecks": false,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "@intlify/vite-plugin-vue-i18n/client"
    ],
    "baseUrl": ".",
    "paths": {
      "~/*": [
        "src/*"
      ],
      "src/*": [
        "src/*"
      ],
      "app/*": [
        "*"
      ],
      "components/*": [
        "src/components/*"
      ],
      "layouts/*": [
        "src/layouts/*"
      ],
      "pages/*": [
        "src/pages/*"
      ],
      "assets/*": [
        "src/assets/*"
      ],
      "boot/*": [
        "src/boot/*"
      ],
      "stores/*": [
        "src/stores/*"
      ]
    }
  },
  "include": [
    "src-pwa/**/*.ts",
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "test/**.ts",
    "src/i18n/index.js"
  ],
  "exclude": [
    "cypress"
  ]
}
