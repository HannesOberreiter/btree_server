{
  "extends": "@quasar/app-vite/tsconfig-preset",
  "compilerOptions": {
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "strictNullChecks": false,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "@intlify/vite-plugin-vue-i18n",
      "@quasar/quasar-app-extension-testing-e2e-cypress"
    ],
    "baseUrl": ".",
    "paths": {
      "~/*": [
        "src/*"
      ],
    }
  },
}
