{
  "name": "btree_vue",
  "version": "6.1.7",
  "description": "Beekeeping Database",
  "productName": "b.tree",
  "author": "HannesOberreiter <hoberreiter@gmail.com>",
  "private": true,
  "scripts": {
    "dev": "quasar dev",
    "dev:pwa": "quasar dev -m pwa",
    "build": "quasar build",
    "build:pwa": "quasar build -m pwa",
    "lint": "eslint --ext .js,.ts,.vue ./",
    "format": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "echo \"See package.json => scripts for available tests.\" && exit 0",
    "postinstall": "npx rimraf ./node_modules/@types/preact & npx rimraf ./node_modules/preact/src/index.d.ts & npx rimraf ./node_modules/preact/src/jsx.d.ts",
    "test:e2e": "cross-env NODE_ENV=test start-test \"quasar dev\" http-get://localhost:9000 \"cypress open --e2e\"",
    "test:e2e:ci": "cross-env NODE_ENV=test start-test \"quasar dev\" http-get://localhost:9000 \"cypress run --e2e\"",
    "test:component": "cross-env NODE_ENV=test cypress open --component",
    "test:component:ci": "cross-env NODE_ENV=test cypress run --component"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.0.2",
